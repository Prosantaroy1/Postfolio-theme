{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#101014", "name": "Base" },
				{ "slug": "base-2", "color": "#1c1c22", "name": "Base Muted" },
				{ "slug": "contrast", "color": "#ffffff", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#a4a4ae", "name": "Contrast Muted" },
				{ "slug": "accent", "color": "#8b7bff", "name": "Accent Indigo" },
				{ "slug": "accent-2", "color": "#ff8a66", "name": "Accent Coral" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
