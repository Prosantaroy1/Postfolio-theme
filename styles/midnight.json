{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#101014",
					"name": "Base"
				},
				{
					"slug": "base-2",
					"color": "#1c1c22",
					"name": "Base Muted"
				},
				{
					"slug": "contrast",
					"color": "#ffffff",
					"name": "Contrast"
				},
				{
					"slug": "contrast-2",
					"color": "#a4a4ae",
					"name": "Contrast Muted"
				},
				{
					"slug": "accent",
					"color": "#8b7bff",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#ff8a66",
					"name": "Accent 2"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "700"
				}
			},
			"button": {
				"border": {
					"radius": "12px"
				},
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			}
		}
	}
}
