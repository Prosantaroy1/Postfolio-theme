{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "section-dark",
	"title": "Dark",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--base)",
			"background": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--contrast)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--base)",
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "color-mix(in srgb, var(--wp--preset--color--base) 30%, transparent)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}
