{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Classic Serif",
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--lora)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "600"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			}
		}
	}
}
