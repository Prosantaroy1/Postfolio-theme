{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Forest",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#f4f7f4",
					"name": "Base"
				},
				{
					"slug": "base-2",
					"color": "#e2ebe2",
					"name": "Base Muted"
				},
				{
					"slug": "contrast",
					"color": "#132a13",
					"name": "Contrast"
				},
				{
					"slug": "contrast-2",
					"color": "#4f6d4f",
					"name": "Contrast Muted"
				},
				{
					"slug": "accent",
					"color": "#2d6a4f",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#d4a373",
					"name": "Accent 2"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "600"
				}
			},
			"button": {
				"border": {
					"radius": "6px"
				},
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			}
		}
	}
}
