{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Cyberpunk",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#0b0e14",
					"name": "Base"
				},
				{
					"slug": "base-2",
					"color": "#161b22",
					"name": "Base Muted"
				},
				{
					"slug": "contrast",
					"color": "#f0f6fc",
					"name": "Contrast"
				},
				{
					"slug": "contrast-2",
					"color": "#8b949e",
					"name": "Contrast Muted"
				},
				{
					"slug": "accent",
					"color": "#00f0ff",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#ff0055",
					"name": "Accent 2"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "800",
					"textTransform": "uppercase",
					"letterSpacing": "0.02em"
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "800"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)"
				}
			}
		}
	}
}
