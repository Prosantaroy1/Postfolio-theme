{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Sunset",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#fffaf5", "name": "Base" },
				{ "slug": "base-2", "color": "#fbeee1", "name": "Base Muted" },
				{ "slug": "contrast", "color": "#241608", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#7a6a5c", "name": "Contrast Muted" },
				{ "slug": "accent", "color": "#e8590c", "name": "Accent Coral" },
				{ "slug": "accent-2", "color": "#0f766e", "name": "Accent Teal" }
			],
			"gradients": [
				{
					"slug": "indigo-to-coral",
					"gradient": "linear-gradient(135deg, #e8590c 0%, #f5b642 100%)",
					"name": "Coral to Amber"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
