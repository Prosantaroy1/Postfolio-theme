{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Nordic",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#f8fafc", "name": "Base" },
				{ "slug": "base-2", "color": "#edf2f7", "name": "Base Muted" },
				{ "slug": "contrast", "color": "#0f172a", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#64748b", "name": "Contrast Muted" },
				{ "slug": "accent", "color": "#0d9488", "name": "Accent Teal" },
				{ "slug": "accent-2", "color": "#3b82f6", "name": "Accent Sky Blue" }
			],
			"gradients": [
				{
					"slug": "indigo-to-coral",
					"gradient": "linear-gradient(135deg, #0d9488 0%, #3b82f6 100%)",
					"name": "Teal to Sky Blue"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
