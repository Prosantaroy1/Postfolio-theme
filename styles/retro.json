{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Retro",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#fbf8f1", "name": "Base" },
				{ "slug": "base-2", "color": "#f0e9d6", "name": "Base Muted" },
				{ "slug": "contrast", "color": "#1c1917", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#78716c", "name": "Contrast Muted" },
				{ "slug": "accent", "color": "#b91c1c", "name": "Accent Crimson" },
				{ "slug": "accent-2", "color": "#c2410c", "name": "Accent Terracotta" }
			],
			"gradients": [
				{
					"slug": "indigo-to-coral",
					"gradient": "linear-gradient(135deg, #b91c1c 0%, #c2410c 100%)",
					"name": "Crimson to Terracotta"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "#ffffff"
					}
				}
			}
		}
	}
}
