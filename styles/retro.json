{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Retro",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fbf8f1",
					"name": "Base"
				},
				{
					"slug": "base-2",
					"color": "#f0e9d6",
					"name": "Base Muted"
				},
				{
					"slug": "contrast",
					"color": "#1c1917",
					"name": "Contrast"
				},
				{
					"slug": "contrast-2",
					"color": "#69625d",
					"name": "Contrast Muted"
				},
				{
					"slug": "accent",
					"color": "#b91c1c",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#c2410c",
					"name": "Accent 2"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--lora)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "700"
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			}
		}
	}
}
