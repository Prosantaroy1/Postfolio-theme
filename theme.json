{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Postfolio Blocks",
	"customTemplates": [
		{
			"name": "home-2",
			"title": "Home 2 (Spotlight)",
			"postTypes": [ "page" ]
		},
		{
			"name": "home-3",
			"title": "Home 3 (Editorial List)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1220px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "base-2", "color": "#f3f3f6", "name": "Base Muted" },
				{ "slug": "contrast", "color": "#101014", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#54545e", "name": "Contrast Muted" },
				{ "slug": "accent", "color": "#4f46e5", "name": "Accent Indigo" },
				{ "slug": "accent-2", "color": "#ff5a36", "name": "Accent Coral" }
			],
			"gradients": [
				{
					"slug": "indigo-to-coral",
					"gradient": "linear-gradient(135deg, #4f46e5 0%, #ff5a36 100%)",
					"name": "Indigo to Coral"
				},
				{
					"slug": "ink-fade",
					"gradient": "linear-gradient(180deg, rgba(16,16,20,0) 0%, rgba(16,16,20,0.85) 100%)",
					"name": "Ink Fade"
				}
			]
		},
		"typography": {
			"writingMode": true,
			"fluid": true,
			"lineHeight": true,
			"dropCap": true,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "\"Manrope Variable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
				}
			],
			"fontFace": [
				{
					"fontFamily": "Manrope Variable",
					"fontStyle": "normal",
					"fontWeight": "200 800",
					"fontStretch": "normal",
					"src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ],
					"fontDisplay": "swap"
				},
				{
					"fontFamily": "Manrope Variable",
					"fontStyle": "normal",
					"fontWeight": "200 800",
					"fontStretch": "normal",
					"src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ],
					"fontDisplay": "swap"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem)", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "clamp(2.25rem, 1.7rem + 2.4vw, 3.5rem)", "name": "XX Large" },
				{ "slug": "huge", "size": "clamp(2.75rem, 1.9rem + 3.8vw, 5rem)", "name": "Huge" }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"steps": 7
			},
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1" },
				{ "slug": "20", "size": "1rem", "name": "2" },
				{ "slug": "30", "size": "1.5rem", "name": "3" },
				{ "slug": "40", "size": "2.5rem", "name": "4" },
				{ "slug": "50", "size": "4rem", "name": "5" },
				{ "slug": "60", "size": "6rem", "name": "6" },
				{ "slug": "70", "size": "9rem", "name": "7" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"blocks": {
			"core/post-featured-image": {
				"border": { "radius": true }
			},
			"core/button": {
				"color": {
					"palette": [
						{ "slug": "base", "color": "#ffffff", "name": "Base" },
						{ "slug": "contrast", "color": "#101014", "name": "Contrast" },
						{ "slug": "accent", "color": "#4f46e5", "name": "Accent Indigo" },
						{ "slug": "accent-2", "color": "#ff5a36", "name": "Accent Coral" }
					]
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--20)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--20)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--contrast)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "800",
					"fontSize": "1.5rem",
					"letterSpacing": "-0.01em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-title": {
				"typography": { "lineHeight": "1.15" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--base-2)" }
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "normal"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "0",
					"style": "solid"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700"
				}
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
				"color": { "background": "var(--wp--preset--color--base-2)" }
			}
		}
	}
}
