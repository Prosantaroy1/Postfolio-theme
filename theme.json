			"gradients": [
				{
					"slug": "indigo-to-coral",
					"name": "Accent to Accent 2",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--accent-2) 100%)"
				},
				{
					"slug": "ink-fade",
					"name": "Ink Fade",
					"gradient": "linear-gradient(180deg, rgba(16,16,20,0) 0%, rgba(16,16,20,0.85) 100%)"
				},
				{
					"slug": "soft-wash",
					"name": "Soft Wash",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--base-2) 0%, var(--wp--preset--color--base) 100%)"
				}
			]
		},
